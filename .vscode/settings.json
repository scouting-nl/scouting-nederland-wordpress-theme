{
    "[css]": {
        "editor.codeActionsOnSave": {
            "source.fixAll.stylelint": "explicit"
        },
        "editor.detectIndentation": false,
        "editor.formatOnPaste": false,
        "editor.formatOnSave": false,
        "editor.insertSpaces": false,
        "editor.tabSize": 4
    },
    "[php]": {
        "editor.defaultFormatter": "ValeryanM.vscode-phpsab",
        "editor.formatOnSave": true,
        "editor.insertSpaces": false,
        "editor.tabSize": 4
    },
    "[javascript]": {
        "editor.defaultFormatter": "dbaeumer.vscode-eslint",
        "editor.detectIndentation": false,
        "editor.formatOnPaste": false,
        "editor.formatOnSave": true,
        "editor.insertSpaces": false,
        "editor.tabSize": 4
    },
    "css.validate": false,
    "eslint.format.enable": true,
    "eslint.validate": ["javascript"],
    "eslint.workingDirectories": [
        {
            "mode": "location"
        }
    ],
    "js/ts.format.enabled": false,
    "phpsab.allowedAutoRulesets": ["phpcs.xml.dist"],
    "phpsab.autoRulesetSearch": true,
    "phpsab.excludeGlobs": ["**/node_modules/**", "**/vendor/**"],
    "phpsab.fixerEnable": true,
    "phpsab.snifferEnable": true,
    "phpsab.snifferMode": "onSave",
    "phpsab.snifferShowFixabilityIcons": true,
    "phpsab.snifferShowSources": true,
    "phpsab.standard": "./phpcs.xml.dist",
    "stylelint.validate": ["css"]
}
