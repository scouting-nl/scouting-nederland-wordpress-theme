root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.php]
indent_style = tab
indent_size = 4
tab_width = 4

[*.{js,css}]
indent_style = tab
indent_size = 4
tab_width = 4

[*.{json,yaml,yml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Preserve third-party assets exactly as distributed.
[assets/vendor/**]
indent_style = unset
indent_size = unset
tab_width = unset
insert_final_newline = false
trim_trailing_whitespace = false

# The vendor README is maintained documentation, not a generated dependency.
[assets/vendor/README.md]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = false
