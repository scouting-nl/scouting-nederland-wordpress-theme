{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 2,
    "settings": {
        "appearanceTools": true,
        "color": {
            "custom": true,
            "customDuotone": false,
            "customGradient": false,
            "defaultPalette": false,
            "palette": [
                {
                    "name": "Scouting groen",
                    "slug": "scouting-groen",
                    "color": "#009036"
                },
                {
                    "name": "Scouting blauw",
                    "slug": "scouting-blauw",
                    "color": "#005ea8"
                },
                {
                    "name": "Scouting geel",
                    "slug": "scouting-geel",
                    "color": "#ffdd00"
                },
                {
                    "name": "Scouting rood",
                    "slug": "scouting-rood",
                    "color": "#e2001a"
                },
                {
                    "name": "Scouting oranje",
                    "slug": "scouting-oranje",
                    "color": "#f29400"
                },
                {
                    "name": "Scouting paars",
                    "slug": "scouting-paars",
                    "color": "#93117e"
                },
                {
                    "name": "Zwart",
                    "slug": "zwart",
                    "color": "#000000"
                },
                {
                    "name": "Wit",
                    "slug": "wit",
                    "color": "#ffffff"
                }
            ]
        },
        "layout": {
            "contentSize": "1140px",
            "wideSize": "1320px"
        },
        "spacing": {
            "blockGap": true,
            "units": [
                "px",
                "rem",
                "%",
                "vw",
                "vh"
            ]
        },
        "typography": {
            "customFontSize": true,
            "fontFamilies": [
                {
                    "name": "Arial",
                    "slug": "arial",
                    "fontFamily": "Arial, Helvetica, sans-serif"
                },
                {
                    "name": "Impact",
                    "slug": "impact",
                    "fontFamily": "Impact, Haettenschweiler, 'Arial Narrow Bold', Arial, sans-serif"
                }
            ]
        }
    },
    "styles": {
        "color": {
            "background": "#ffffff",
            "text": "#222222"
        },
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--arial)"
        },
        "elements": {
            "button": {
                "color": {
                    "background": "var(--wp--preset--color--scouting-groen)",
                    "text": "var(--wp--preset--color--wit)"
                }
            },
            "heading": {
                "color": {
                    "text": "var(--wp--preset--color--scouting-groen)"
                },
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--arial)",
                    "fontWeight": "700"
                }
            },
            "link": {
                "color": {
                    "text": "var(--wp--preset--color--scouting-blauw)"
                }
            }
        },
        "spacing": {
            "blockGap": "1.5rem"
        }
    }
}