{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "custom": {
      "color": {
        "bootstrapBorder": "#ced4da",
        "danger": "#ec1c24",
        "linkHover": "#005799",
        "navbarText": "rgba(0, 0, 0, 0.9)",
        "offcanvasBorder": "rgba(0, 0, 0, 0.2)",
        "surfaceMuted": "#e3e7eb",
        "text": "#222222"
      }
    },
    "color": {
      "custom": true,
      "customDuotone": false,
      "customGradient": false,
      "defaultPalette": false,
      "palette": [
        {
          "name": "Scouting green",
          "slug": "scouting-groen",
          "color": "#00a551"
        },
        {
          "name": "Scouting blue",
          "slug": "scouting-blauw",
          "color": "#0066b2"
        },
        {
          "name": "Scouting blue accent",
          "slug": "scouting-blauw-accent",
          "color": "#006fb9"
        },
        {
          "name": "Scouting yellow",
          "slug": "scouting-geel",
          "color": "#fcdd17"
        },
        {
          "name": "Scouting red",
          "slug": "scouting-rood",
          "color": "#e1071a"
        },
        {
          "name": "Scouting orange",
          "slug": "scouting-oranje",
          "color": "#f2940a"
        },
        {
          "name": "Scouting purple",
          "slug": "scouting-paars",
          "color": "#921c7f"
        },
        {
          "name": "Black",
          "slug": "zwart",
          "color": "#000000"
        },
        {
          "name": "White",
          "slug": "wit",
          "color": "#ffffff"
        }
      ]
    },
    "layout": {
      "contentSize": "1140px",
      "wideSize": "1320px"
    },
    "spacing": {
      "blockGap": true,
      "units": [
        "px",
        "rem",
        "%",
        "vw",
        "vh"
      ]
    },
    "typography": {
      "customFontSize": true,
      "fontFamilies": [
        {
          "name": "Poppins",
          "slug": "poppins",
          "fontFamily": "Poppins, Arial, Helvetica, sans-serif"
        },
        {
          "name": "Roboto Slab",
          "slug": "roboto-slab",
          "fontFamily": "'Roboto Slab', Georgia, serif"
        },
        {
          "name": "Impact",
          "slug": "impact",
          "fontFamily": "Impact, Haettenschweiler, 'Arial Narrow Bold', sans-serif"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|wit",
      "text": "var:preset|color|zwart"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|poppins"
    },
    "elements": {
      "button": {
        "color": {
          "background": "var:preset|color|scouting-groen",
          "text": "var:preset|color|wit"
        }
      },
      "heading": {
        "color": {
          "text": "var:preset|color|scouting-groen"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|roboto-slab",
          "fontWeight": "700"
        }
      },
      "link": {
        "color": {
          "text": "var:preset|color|scouting-blauw"
        }
      }
    },
    "spacing": {
      "blockGap": "1.5rem"
    }
  }
}
