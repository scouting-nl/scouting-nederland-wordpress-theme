{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 2,
    "settings": {
        "appearanceTools": true,
        "custom": {
            "color": {
                "bootstrapBorder": "#ced4da",
                "danger": "#ec1c24",
                "linkHover": "#005799",
                "navbarText": "rgba(0, 0, 0, 0.9)",
                "offcanvasBorder": "rgba(0, 0, 0, 0.2)",
                "surfaceMuted": "#e3e7eb",
                "text": "#222222"
            }
        },
        "color": {
            "custom": true,
            "customDuotone": false,
            "customGradient": false,
            "defaultPalette": false,
            "palette": [
                {
                    "name": "Scouting groen",
                    "slug": "scouting-groen",
                    "color": "#00a551"
                },
                {
                    "name": "Scouting blauw",
                    "slug": "scouting-blauw",
                    "color": "#0066b2"
                },
                {
                    "name": "Scouting blauw accent",
                    "slug": "scouting-blauw-accent",
                    "color": "#006fb9"
                },
                {
                    "name": "Scouting geel",
                    "slug": "scouting-geel",
                    "color": "#fcdd17"
                },
                {
                    "name": "Scouting rood",
                    "slug": "scouting-rood",
                    "color": "#e1071a"
                },
                {
                    "name": "Scouting oranje",
                    "slug": "scouting-oranje",
                    "color": "#f2940a"
                },
                {
                    "name": "Scouting paars",
                    "slug": "scouting-paars",
                    "color": "#921c7f"
                },
                {
                    "name": "Zwart",
                    "slug": "zwart",
                    "color": "#000000"
                },
                {
                    "name": "Wit",
                    "slug": "wit",
                    "color": "#ffffff"
                }
            ]
        },
        "layout": {
            "contentSize": "1140px",
            "wideSize": "1320px"
        },
        "spacing": {
            "blockGap": true,
            "units": [
                "px",
                "rem",
                "%",
                "vw",
                "vh"
            ]
        },
        "typography": {
            "customFontSize": true,
            "fontFamilies": [
                {
                    "name": "Poppins",
                    "slug": "poppins",
                    "fontFamily": "Poppins, Arial, Helvetica, sans-serif"
                },
                {
                    "name": "Roboto Slab",
                    "slug": "roboto-slab",
                    "fontFamily": "'Roboto Slab', Georgia, serif"
                }
            ]
        }
    },
    "styles": {
        "color": {
            "background": "var:preset|color|wit",
            "text": "var:preset|color|zwart"
        },
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--poppins)"
        },
        "elements": {
            "button": {
                "color": {
                    "background": "var:preset|color|scouting-groen",
                    "text": "var:preset|color|wit"
                }
            },
            "heading": {
                "color": {
                    "text": "var:preset|color|scouting-groen"
                },
                "typography": {
                    "fontFamily": "var:preset|font-family|roboto-slab",
                    "fontWeight": "700"
                }
            },
            "link": {
                "color": {
                    "text": "var:preset|color|scouting-blauw"
                }
            }
        },
        "spacing": {
            "blockGap": "1.5rem"
        }
    }
}
